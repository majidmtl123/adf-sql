						"parameters": {
							"city": {
								"value": "@pipeline().parameters.city",
								"type": "Expression"
							},
							"key": {
								"value": "@pipeline().parameters.key",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "Json1",
						"type": "DatasetReference"
					}
				]
			}
		],
		"parameters": {
			"city": {
				"type": "string",
				"defaultValue": "montreal"
			},
			"key": {
				"type": "string",
				"defaultValue": "b6388b2c58b856dd031506d0a154d7d9"
			}
		},
		"annotations": []
	}
}